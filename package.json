{
  "name": "mcp-svg-to-font",
  "version": "1.2.0",
  "description": "MCP Server para generar fuentes desde archivos SVG",
  "main": "./dist/main.js",
  "bin": {
    "mcp-svg-to-font": "./dist/main.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "clean": "rm -rf dist",
    "build:watch": "tsc --watch",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "mcp",
    "svg",
    "font",
    "icons",
    "glyphs",
    "typography"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.11.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "fs-extra": "^11.2.0",
    "glob": "^11.0.0",
    "opentype.js": "^1.3.4",
    "webfont": "^11.2.26",
    "zod": "^3.25.36"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.0.0",
    "@types/opentype.js": "^1.3.8",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
