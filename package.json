{
  "name": "mcp-svg-to-fonts",
  "version": "1.4.1",
  "description": "MCP Server para generar fuentes desde archivos SVG",
  "main": "./dist/main.js",
  "bin": {
    "mcp-svg-to-fonts": "dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "clean": "rm -rf dist",
    "build:watch": "tsc --watch",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "mcp",
    "svg",
    "font",
    "icons",
    "glyphs",
    "typography"
  ],
  "author": {
    "name": "Omar Jimenez",
    "url": "https://omarjs.com"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omy13/mcp-svg-to-fonts.git"
  },
  "bugs": {
    "url": "https://github.com/omy13/mcp-svg-to-fonts/issues"
  },
  "homepage": "https://github.com/omy13/mcp-svg-to-fonts#readme",
  "packageManager": "pnpm@10.34.9",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fs-extra": "^11.4.1",
    "glob": "^14.0.3",
    "opentype.js": "^2.0.0",
    "webfont": "^11.2.26",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.20.5",
    "@types/opentype.js": "^1.3.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "overrides": {
      "webfont>xml2js": "^0.6.2"
    }
  }
}
